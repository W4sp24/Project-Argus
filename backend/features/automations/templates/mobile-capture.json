{
  "name": "Argus: Mobile Capture",
  "nodes": [
    {
      "id": "trigger",
      "name": "Capture Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "argus-mobile-capture",
      "parameters": {
        "path": "argus-mobile-capture",
        "formTitle": "Quick Capture",
        "formDescription": "Jot something down from your phone — it lands in Argus.",
        "responseMode": "lastNode",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Note",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "What's on your mind?"
            },
            {
              "fieldLabel": "Tags",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "comma, separated, tags"
            }
          ]
        }
      }
    },
    {
      "id": "push",
      "name": "Send to Argus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [220, 0],
      "parameters": {
        "method": "POST",
        "url": "{{ARGUS_URL}}/api/external/capture",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{ARGUS_TOKEN}}"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json.Note, \"tags\": $json.Tags ? $json.Tags.split(',').map(t => t.trim()).filter(t => t) : [] } }}"
      }
    }
  ],
  "connections": {
    "Capture Form": {
      "main": [[{"node": "Send to Argus", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{"name": "argus"}]
}
