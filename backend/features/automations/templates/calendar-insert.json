{
  "name": "Argus: Add Calendar Event",
  "nodes": [
    {
      "id": "trigger",
      "name": "New Event Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "argus-calendar-insert",
      "parameters": {
        "path": "argus-calendar-insert",
        "formTitle": "Add Calendar Event",
        "formDescription": "Writes a new event straight onto your Google Calendar.",
        "responseMode": "lastNode",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Title",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Event title"
            },
            {
              "fieldLabel": "Start",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldLabel": "End",
              "fieldType": "date",
              "requiredField": true
            }
          ]
        }
      }
    },
    {
      "id": "gcal_create",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": {
        "operation": "create",
        "calendar": "primary",
        "start": "={{ $json.Start }}",
        "end": "={{ $json.End }}",
        "additionalFields": {
          "summary": "={{ $json.Title }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {"name": "Google Calendar account"}
      }
    }
  ],
  "connections": {
    "New Event Form": {
      "main": [[{"node": "Create Calendar Event", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{"name": "argus"}]
}
